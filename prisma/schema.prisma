generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  collection  String?
  price       Int
  compareAt   Int?
  sku         String?
  stock       Int      @default(0)
  status      String   @default("draft") // draft | published | archived
  colors      String?  // comma-separated hex
  description String?
  material    String?
  care        String?
  images      String?  // comma-separated URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  reviews     Review[]
}

model Category {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  order  Int    @default(0)
  status String @default("visible")
}

model Collection {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?
  cover       String?
  order       Int    @default(0)
  status      String @default("active")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id         String      @id @default(cuid())
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  email      String
  name       String
  address    String?
  city       String?
  zip        String?
  items      OrderItem[]
  subtotal   Int
  shipping   Int         @default(0)
  total      Int
  payment    String      @default("Pending") // Pending | Paid
  method     String      @default("card")
  status     String      @default("pending") // pending|processing|packed|shipped|delivered|cancelled|refunded|returned
  carrier    String?
  tracking   String?
  createdAt  DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  size      String?
  price     Int
  qty       Int
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  type       String   // percentage | fixed | free_shipping
  value      Int      @default(0)
  minOrder   Int      @default(0)
  usageLimit Int      @default(0)
  active     Boolean  @default(true)
  expiry     String?
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  name      String
  text      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String // JSON string
}

model AuditLog {
  id       String   @id @default(cuid())
  action   String
  resource String
  meta     String?
  by       String
  ts       DateTime @default(now())
}
